# SIH26153 Environment Configuration
# Copy this file to .env and adjust values for your deployment

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Model Configuration
MODEL_DIR=models
SEQUENCE_DIR=data/sequences
PROCESSED_DIR=data/processed
RAW_DIR=data/raw

# Dataset Configuration
MAX_ROWS=100000
N_CAMPAIGNS=100
WINDOW_SIZE=20

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend Configuration
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000

# Model Selection (markov, lstm, transformer)
DEFAULT_MODEL=transformer

# Evaluation Configuration
EVALUATION_SPLIT=0.8
RANDOM_SEED=42
